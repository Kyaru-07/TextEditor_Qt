<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <!-- 文件 -->
        <file alias="file-new.svg">icons/file-new.svg</file>
        <file alias="file-open.svg">icons/file-open.svg</file>
        <file alias="file-save.svg">icons/file-save.svg</file>
        <file alias="file-save-as.svg">icons/file-save-as.svg</file>
        <file alias="file-print.svg">icons/file-print.svg</file>
        <file alias="file-print-preview.svg">icons/file-print-preview.svg</file>
        <file alias="file-exit.svg">icons/file-exit.svg</file>

        <!-- 编辑 -->
        <file alias="edit-undo.svg">icons/edit-undo.svg</file>
        <file alias="edit-redo.svg">icons/edit-redo.svg</file>
        <file alias="edit-cut.svg">icons/edit-cut.svg</file>
        <file alias="edit-copy.svg">icons/edit-copy.svg</file>
        <file alias="edit-paste.svg">icons/edit-paste.svg</file>
        <file alias="edit-delete.svg">icons/edit-delete.svg</file>
        <file alias="edit-select-all.svg">icons/edit-select-all.svg</file>
        <file alias="edit-find.svg">icons/edit-find.svg</file>
        <file alias="edit-find-next.svg">icons/edit-find-next.svg</file>
        <file alias="edit-replace.svg">icons/edit-replace.svg</file>

        <!-- 格式 -->
        <file alias="format-font.svg">icons/format-font.svg</file>
        <file alias="format-font-size.svg">icons/format-font-size.svg</file>
        <file alias="format-font-color.svg">icons/format-font-color.svg</file>
        <file alias="format-bg-color.svg">icons/format-bg-color.svg</file>
        <file alias="format-bold.svg">icons/format-bold.svg</file>
        <file alias="format-italic.svg">icons/format-italic.svg</file>
        <file alias="format-underline.svg">icons/format-underline.svg</file>
        <file alias="format-wrap.svg">icons/format-wrap.svg</file>

        <!-- 视图 / 帮助 -->
        <file alias="view-linenumber.svg">icons/view-linenumber.svg</file>
        <file alias="view-toolbar.svg">icons/view-toolbar.svg</file>
        <file alias="view-statusbar.svg">icons/view-statusbar.svg</file>
        <file alias="help-about.svg">icons/help-about.svg</file>
        <file alias="help-help.svg">icons/help-help.svg</file>
        <file alias="autosave.svg">icons/autosave.svg</file>
        <file alias="warn-unsaved.svg">icons/warn-unsaved.svg</file>
        <file alias="format-editor-bg.svg">icons/format-editor-bg.svg</file>
    </qresource>
</RCC>
